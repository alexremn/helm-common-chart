---
# Source: common-smoke/templates/all.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: app-config
  labels:
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: config-secret-annotations-app
    app.kubernetes.io/component: web
    helm.sh/environment: dev
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/version: "7.8.9"
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
    example.com/owner: platform
data:
  LOG_LEVEL: "info"
---
# Source: common-smoke/templates/all.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: app-secrets
  labels: 
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: config-secret-annotations-app
    app.kubernetes.io/component: web
    helm.sh/environment: dev
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/version: "7.8.9"
  annotations:
    force-sync: "<NOW>"
    argocd.argoproj.io/sync-wave: "-2"
spec:
  refreshInterval: "10000h"
  secretStoreRef:
    name: my-store
    kind: ClusterSecretStore
  target:
    name: app-secrets
    creationPolicy: Owner
  data:
      - secretKey: DB_PASSWORD
        remoteRef:
          key: /apps/internal/api
          property: DB_PASSWORD

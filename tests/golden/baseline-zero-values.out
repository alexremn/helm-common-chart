        app.kubernetes.io/instance: smoke
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: "7.8.9"
    spec:
      containers:
        - name: zv-rails-zero
          image: ghcr.io/example/app:1.0.0
          imagePullPolicy: "IfNotPresent"
          readinessProbe:
            httpGet:
              path: /health_check/full
              port: http
            initialDelaySeconds: 0
            periodSeconds: 10
            failureThreshold: 5
            timeoutSeconds: 3
          livenessProbe:
            httpGet:
              path: /health_check/full

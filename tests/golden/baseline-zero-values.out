apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: zv-scaled-zero
  labels:
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: zero-app
    app.kubernetes.io/component: zv-scaled-zero
    helm.sh/environment: "dev"
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/version: "7.8.9"
spec:
  scaleTargetRef:
    name: zv-scaled-zero
    kind: Deployment
  pollingInterval: 30
  cooldownPeriod: 180
  minReplicaCount: 1
  maxReplicaCount: 3
  advanced:
    restoreToOriginalReplicaCount: false
  fallback:
    failureThreshold: 3
    replicas: 0
  triggers:
    - type: cron
      metadata:
        timezone: "UTC"
        start: "0 8 * * *"
        end: "0 20 * * *"
        desiredReplicas: "3"
---

---
# Source: common-smoke/templates/all.yaml
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: zv-ds-zero
  labels:
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: zero-app
    app.kubernetes.io/component: zv-ds-zero
    helm.sh/environment: "dev"
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/version: "7.8.9"
spec:
  minReadySeconds: 0
  revisionHistoryLimit: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: zero-app
      app.kubernetes.io/component: zv-ds-zero
      app.kubernetes.io/instance: smoke
  template:
    metadata:
      labels:
        helm.sh/chart: common-smoke-0.1.0
        app.kubernetes.io/name: zero-app
        app.kubernetes.io/component: zv-ds-zero
        helm.sh/environment: "dev"
        app.kubernetes.io/instance: smoke
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: "7.8.9"
    spec:
      containers:
        - name: zv-ds-zero
          image: ghcr.io/example/app:1.0.0
          imagePullPolicy: "IfNotPresent"
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 0
            periodSeconds: 10
            failureThreshold: 3
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 0
            periodSeconds: 10
            failureThreshold: 3
            timeoutSeconds: 1
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
      terminationGracePeriodSeconds: 30
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      automountServiceAccountToken: false
---

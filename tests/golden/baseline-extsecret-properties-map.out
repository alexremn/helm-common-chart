---
# Source: common-smoke/templates/all.yaml
apiVersion: v1
kind: Service
metadata:
  name: web
  labels:
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: extsecret-properties-map
    app.kubernetes.io/component: web
    helm.sh/environment: production
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/version: "7.8.9"
spec:
  type: ClusterIP
  ports:
    - name: http
      port: 8080
      targetPort: http
      protocol: TCP
  selector:
    app.kubernetes.io/name: extsecret-properties-map
    app.kubernetes.io/component: web
    app.kubernetes.io/instance: smoke
---
# Source: common-smoke/templates/all.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  labels:
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: extsecret-properties-map
    app.kubernetes.io/component: web
    helm.sh/environment: production
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/version: "7.8.9"
spec:
  replicas: 1
  minReadySeconds: 10
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 25%
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: extsecret-properties-map
      app.kubernetes.io/component: web
      app.kubernetes.io/instance: smoke
  template:
    metadata:
      labels:
        helm.sh/chart: common-smoke-0.1.0
        app.kubernetes.io/name: extsecret-properties-map
        app.kubernetes.io/component: web
        helm.sh/environment: production
        app.kubernetes.io/instance: smoke
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: "7.8.9"
    spec:
      containers:
        - name: web
          image: ghcr.io/example/app:1.0.0
          imagePullPolicy: "IfNotPresent"
          ports:
          - name: http
            containerPort: 8080
            protocol: TCP
          envFrom:
            - secretRef:
                name: "renamed"
            - secretRef:
                name: "plain"
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 0
            periodSeconds: 10
            failureThreshold: 3
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 0
            periodSeconds: 10
            failureThreshold: 3
            timeoutSeconds: 1
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
      terminationGracePeriodSeconds: 30
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      automountServiceAccountToken: false
---
# Source: common-smoke/templates/all.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: plain
  labels: 
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: extsecret-properties-map
    app.kubernetes.io/component: web
    helm.sh/environment: production
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/version: "7.8.9"
  annotations:
    force-sync: "<NOW>"
spec:
  refreshInterval: "10000h"
  secretStoreRef:
    name: my-cluster-store
    kind: ClusterSecretStore
  target:
    name: plain
    creationPolicy: Owner
  data:
      - secretKey: TOKEN
        remoteRef:
          key: secret/data/app
          property: TOKEN
      - secretKey: API_KEY
        remoteRef:
          key: secret/data/app
          property: API_KEY
---
# Source: common-smoke/templates/all.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: renamed
  labels: 
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: extsecret-properties-map
    app.kubernetes.io/component: web
    helm.sh/environment: production
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/version: "7.8.9"
  annotations:
    force-sync: "<NOW>"
spec:
  refreshInterval: "10000h"
  secretStoreRef:
    name: my-cluster-store
    kind: ClusterSecretStore
  target:
    name: renamed
    creationPolicy: Owner
  data:
      - secretKey: CA_CERT
        remoteRef:
          key: secret/data/pki
          property: ca-certificate
      - secretKey: CA_PRIVATE_KEY
        remoteRef:
          key: secret/data/pki
          property: ca-private-key
      - secretKey: UID_SECRET_KEY
        remoteRef:
          key: secret/data/pki
          property: uid-secret-key

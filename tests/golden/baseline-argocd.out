# Source: common-smoke/templates/all.yaml
apiVersion: batch/v1
kind: Job
metadata:
  name: run-task
  labels:
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: argocd-app
    app.kubernetes.io/component: run-task
    helm.sh/environment: staging
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: argocd
    app.kubernetes.io/version: "7.8.9"
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-options: ServerSideApply=true
    argocd.argoproj.io/sync-wave: "5"
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        helm.sh/chart: common-smoke-0.1.0
        app.kubernetes.io/name: argocd-app
        app.kubernetes.io/component: run-task
        helm.sh/environment: staging
        app.kubernetes.io/instance: smoke
        app.kubernetes.io/managed-by: argocd
        app.kubernetes.io/version: "7.8.9"
    spec:
      containers:
        - name: run-task
          image: ghcr.io/example/app:1.0.0
          imagePullPolicy: "IfNotPresent"
          command: 
            - /bin/sh
            - -c
          args: 
            - echo migrate
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
      restartPolicy: "Never"
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      automountServiceAccountToken: false
---
# Source: common-smoke/templates/all.yaml
apiVersion: batch/v1
kind: CronJob
metadata:
  name: sync-task
  labels:
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: argocd-app
    app.kubernetes.io/component: sync-task
    helm.sh/environment: staging
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: argocd
    app.kubernetes.io/version: "7.8.9"
  annotations:
    argocd.argoproj.io/sync-options: ServerSideApply=true
    argocd.argoproj.io/sync-wave: "5"
spec:
  schedule: "0 * * * *"
  concurrencyPolicy: "Forbid"
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 1
  jobTemplate:
    metadata:
      annotations:
        argocd.argoproj.io/compare-options: IgnoreExtraneous
    spec:
      backoffLimit: 0
      template:
        metadata:
          labels:
            helm.sh/chart: common-smoke-0.1.0
            app.kubernetes.io/name: argocd-app
            app.kubernetes.io/component: sync-task
            helm.sh/environment: staging
            app.kubernetes.io/instance: smoke
            app.kubernetes.io/managed-by: argocd
            app.kubernetes.io/version: "7.8.9"
        spec:
          containers:
            - name: sync-task
              image: ghcr.io/example/app:1.0.0
              imagePullPolicy: "IfNotPresent"
              command: 
                - /bin/sh
                - -c
              args: 
                - echo sync
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                  - ALL
          restartPolicy: "Never"
          securityContext:
            seccompProfile:
              type: RuntimeDefault
          automountServiceAccountToken: false
---
# Source: common-smoke/templates/all.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: app-secrets
  labels: 
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: argocd-app
    app.kubernetes.io/component: web
    helm.sh/environment: staging
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: argocd
    app.kubernetes.io/version: "7.8.9"
  annotations:
    argocd.argoproj.io/sync-options: ServerSideApply=true
    argocd.argoproj.io/sync-wave: "-1"
spec:
  refreshInterval: "10000h"
  secretStoreRef:
    name: my-cluster-store
    kind: ClusterSecretStore
  target:
    name: app-secrets
    creationPolicy: Owner
  data:
      - secretKey: API_KEY
        remoteRef:
          key: internal/app/staging
          property: API_KEY
---
# Source: common-smoke/templates/all.yaml
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: web
  labels:
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: argocd-app
    app.kubernetes.io/component: web
    helm.sh/environment: staging
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: argocd
    app.kubernetes.io/version: "7.8.9"
  annotations:
    argocd.argoproj.io/sync-options: ServerSideApply=true
    argocd.argoproj.io/sync-wave: "5"
spec:
  scaleTargetRef:
    name: web
    kind: Deployment
  pollingInterval: 30
  cooldownPeriod: 180
  minReplicaCount: 2
  maxReplicaCount: 5
  advanced:
    restoreToOriginalReplicaCount: false
  fallback:
    failureThreshold: 3
    replicas: 1
  triggers:
    - type: prometheus
      metadata:
        serverAddress: http://prometheus.monitoring:9090
        threshold: "1"
        query: "vector(1)"

# Source: common-smoke/templates/all.yaml
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: stateful
  labels:
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: grouped-app
    app.kubernetes.io/component: stateful
    helm.sh/environment: "staging"
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: argocd
    app.kubernetes.io/version: "7.8.9"
    app.example.com/tier: "backend"
    app.kubernetes.io/part-of: "fallback"
spec:
  serviceName: "stateful-headless"
  updateStrategy:
    type: "RollingUpdate"
  podManagementPolicy: "OrderedReady"
  minReadySeconds: 0
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: grouped-app
      app.kubernetes.io/component: stateful
      app.example.com/tier: "backend"
      app.kubernetes.io/part-of: "fallback"
  template:
    metadata:
      labels:
        helm.sh/chart: common-smoke-0.1.0
        app.kubernetes.io/name: grouped-app
        app.kubernetes.io/component: stateful
        helm.sh/environment: "staging"
        app.kubernetes.io/instance: smoke
        app.kubernetes.io/managed-by: argocd
        app.kubernetes.io/version: "7.8.9"
        app.example.com/tier: "backend"
        app.kubernetes.io/part-of: "fallback"
      annotations:
        checksum/config: a30a9284655512730bd062681b6bbe958259c85493d4b94434780ea71a0cbd1d
    spec:
      containers:
        - name: stateful
          image: ghcr.io/example/app:1.0.0
          imagePullPolicy: "IfNotPresent"
          ports:
          - name: http
            containerPort: 8080
            protocol: TCP
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 0
            periodSeconds: 10
            failureThreshold: 3
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 0
            periodSeconds: 10
            failureThreshold: 3
            timeoutSeconds: 1
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
          volumeMounts:
            - name: data
              mountPath: /mnt/data
      terminationGracePeriodSeconds: 30
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      automountServiceAccountToken: false
  volumeClaimTemplates:
    - metadata:
        name: data
        labels:
          helm.sh/chart: common-smoke-0.1.0
          app.kubernetes.io/name: grouped-app
          app.kubernetes.io/component: stateful
          helm.sh/environment: "staging"
          app.kubernetes.io/instance: smoke
          app.kubernetes.io/managed-by: argocd
          app.kubernetes.io/version: "7.8.9"
          app.example.com/tier: "backend"
          app.kubernetes.io/part-of: "fallback"
      spec: 
        accessModes: [ReadWriteOnce]
        resources:
          requests:
            storage: "5Gi"
        storageClassName: standard

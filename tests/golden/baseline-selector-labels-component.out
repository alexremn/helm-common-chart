# Source: common-smoke/templates/all.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  labels:
    helm.sh/chart: common-smoke-0.1.0
    app.kubernetes.io/name: grouped-app
    app.kubernetes.io/component: "general"
    helm.sh/environment: "staging"
    app.kubernetes.io/instance: smoke
    app.kubernetes.io/managed-by: argocd
    app.kubernetes.io/version: "7.8.9"
    app.example.com/tier: "backend"
    app.kubernetes.io/part-of: "web"
spec:
  replicas: 1
  minReadySeconds: 10
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 25%
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: grouped-app
      app.kubernetes.io/component: "general"
      app.example.com/tier: "backend"
      app.kubernetes.io/part-of: "web"
  template:
    metadata:
      labels:
        helm.sh/chart: common-smoke-0.1.0
        app.kubernetes.io/name: grouped-app
        app.kubernetes.io/component: "general"
        helm.sh/environment: "staging"
        app.kubernetes.io/instance: smoke
        app.kubernetes.io/managed-by: argocd
        app.kubernetes.io/version: "7.8.9"
        app.example.com/tier: "backend"
        app.kubernetes.io/part-of: "web"
      annotations:
        checksum/config: eb2b7c406ddd01802080b8bd90e221e9c494ad92862d015a6c75c65c98544768
    spec:
      containers:
        - name: web
          image: ghcr.io/example/app:1.0.0
          imagePullPolicy: "IfNotPresent"
          ports:
          - name: http
            containerPort: 8080
            protocol: TCP
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 0
            periodSeconds: 10
            failureThreshold: 3
            timeoutSeconds: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 0
            periodSeconds: 10
            failureThreshold: 3
            timeoutSeconds: 1
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
      terminationGracePeriodSeconds: 30
      securityContext:
        seccompProfile:
          type: RuntimeDefault
      automountServiceAccountToken: false

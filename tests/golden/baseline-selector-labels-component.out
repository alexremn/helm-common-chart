  clusterIP: None
  ports:
    - name: http
      port: 8080
      targetPort: http
      protocol: TCP
  selector:
    app.kubernetes.io/name: grouped-app
    app.kubernetes.io/component: stateful
    app.example.com/tier: "backend"
    app.kubernetes.io/part-of: "fallback"
  publishNotReadyAddresses: false
